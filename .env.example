NODE_ENV=development
PORT=4000

# Matches docker-compose.yml at the project root
DATABASE_URL=postgresql://twcs:twcs@localhost:5432/twcs?schema=public

# Replace with a long random string (min 16 chars)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Shared key IoT gateways send in the x-device-key header
DEVICE_API_KEY=dev-device-key-change-me

# Factory local time zone (used by the schedule engine)
TIMEZONE=Asia/Colombo

# Generate fake sensor readings in development
ENABLE_SIMULATOR=true
SIMULATOR_INTERVAL_MS=5000
