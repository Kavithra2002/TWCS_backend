NODE_ENV=development
PORT=4000

# Local PostgreSQL used for development (user postgres, database twcs).
# Copy this file to .env and set the password. Docker Compose uses twcs:twcs instead.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/twcs?schema=public

# Replace with a long random string (min 16 chars)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Shared key IoT gateways send in the x-device-key header
DEVICE_API_KEY=dev-device-key-change-me

# Factory local time zone (used by the schedule engine)
TIMEZONE=Asia/Colombo

# Generate fake sensor readings in development
ENABLE_SIMULATOR=true
SIMULATOR_INTERVAL_MS=5000

# Test Version: publish moc_json → DigitalOcean Mosquitto; poll withering_db via SSH tunnel
MQTT_BROKER_URL=mqtt://168.144.35.189:1883
MQTT_CLIENT_ID=localhost-publisher-1
MQTT_TOPIC_SESSION=withering/session
MQTT_TOPIC_EVENTS=withering/events
MQTT_TOPIC_TIMESERIES=withering/timeseries
MQTT_PUBLISH_INTERVAL_MS=10000
# ssh -L 15432:127.0.0.1:5432 root@168.144.35.189
VBOX_DATABASE_URL=postgresql://vbox_user:twcsdbpw@127.0.0.1:15432/withering_db
